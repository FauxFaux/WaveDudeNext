<?xml version="1.0" encoding="utf-8"?>
<!-- Single-file, framework-dependent publish for 64-bit Windows: one EXE in bin\Publish, named WaveDudeNext-<version>.exe
     for the release by the project's NameReleaseFile target, the colour schemes and the examples embedded, no symbol
     files beside it. The .NET Desktop Runtime must be on the user's machine; without it the host shows Microsoft's
     "You must install .NET" dialog with the download link. SingleFileBundled.pubxml is the self-contained counterpart.
     No ReadyToRun (2026-11-03, the user's choice after a day with it): precompiled code must stay valid across servicing
     of the runtime, so it inlines nothing from outside its assembly and reaches every framework method and struct layout
     through an indirection, which made the painter's per-pixel path 5-10x slower than the code the runtime's JIT makes
     at a first call, until a tier-1 promotion a busy window postpones. With quick JIT off (Directory.Build.props) every
     method of this code is compiled optimised at its first call in every build, this one included, for about 0.45 s of
     start-up JIT. The details and the SDK trap a return would have to mind are in CLAUDE.md under Publish.
     dotnet publish WaveDudeNext.WPF/WaveDudeNext.WPF.csproj -p:PublishProfile=SingleFile -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\Publish\</PublishDir>
    <NameReleaseFile>true</NameReleaseFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
